{
  "pages": {
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ],
    "/not-found": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/not-found.js"
    ],
    "/[countryCode]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/[countryCode]/page.css",
      "static/chunks/app/[countryCode]/page.js"
    ],
    "/api/countries/[...path]/route": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/api/countries/[...path]/route.js"
    ]
  }
}